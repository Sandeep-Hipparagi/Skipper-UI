{
  "name": "skipper-ui",
  "version": "1.0.0",
  "description": "Reconstructed interactive motion components for Skipper UI",
  "author": "Sandeep Hipparagi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sandeep-Hipparagi/Skipper-UI.git"
  },
  "homepage": "https://github.com/Sandeep-Hipparagi/Skipper-UI#readme",
  "bugs": {
    "url": "https://github.com/Sandeep-Hipparagi/Skipper-UI/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/catalog.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify:assets": "node scripts/verify-assets.mjs",
    "smoke": "node scripts/audit-skippers.mjs",
    "verify": "npm test && npm run typecheck && npm run verify:assets && npm run build",
    "export:component": "node --experimental-strip-types scripts/export-component.ts",
    "harvest": "tsx harvest-skipper.ts",
    "harvest:sample": "tsx harvest-skipper.ts --only 1,40",
    "harvest:full": "tsx harvest-skipper.ts --start 1 --end 107 --concurrency 3",
    "audit:thumbnails": "npx tsx scripts/capture-thumbnails.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@number-flow/react": "^0.6.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.105.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.6.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dialkit": "^2.1.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^14.7.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.62.0",
    "media-chrome": "^4.19.4",
    "next": "^15.5.28",
    "playwright": "^1.49.1",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-use-measure": "^2.1.7",
    "swiper": "^14.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "^8.5.32"
  }
}
